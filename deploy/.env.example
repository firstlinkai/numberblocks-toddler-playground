# Copy to deploy/.env on the VPS and match your existing Traefik.
# `docker network ls` shows the network name; the certresolver and entrypoint
# names come from your Traefik static config (traefik.yml / command flags).
DOMAIN=numberblocks.suneelp.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Only needed if you uncomment the basicauth middleware in docker-compose.yml.
# BASIC_AUTH=user:$$apr1$$....
